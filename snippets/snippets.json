  "Advanced Database CRUD Class": {
    "prefix": "phpdb_crud",
    "body": [
      "class ${1:DatabaseWrapper} ",
      "{",
      "    private static \\$instance = null;",
      "    private \\$conn;",
      "",
      "    public static function getInstance() ",
      "    {",
      "        if (self::\\$instance === null) {",
      "            self::\\$instance = new self();",
      "        }",
      "        return self::\\$instance;",
      "    }",
      "",
      "    public function getConnection() ",
      "    {",
      "        return \\$this->conn;",
      "    }",
      "",
      "    public function query(\\$sql, \\$params = []) ",
      "    {",
      "        try {",
      "            \\$stmt = \\$this->conn->prepare(\\$sql);",
      "            if (!empty(\\$params)) {",
      "                foreach (\\$params as \\$key => \\$value) {",
      "                    \\$stmt->bindValue(\\$key, \\$value);",
      "                }",
      "            }",
      "            \\$stmt->execute();",
      "            return \\$stmt->fetchAll(PDO::FETCH_ASSOC);",
      "        } catch (PDOException \\$e) {",
      "            error_log(\"Query failed: \" . \\$e->getMessage());",
      "            return false;",
      "        }",
      "    }",
      "",
      "    public function insert(\\$table, \\$data) ",
      "    {",
      "        \\$columns = implode(\", \", array_keys(\\$data));",
      "        \\$placeholders = \":\" . implode(\", :\", array_keys(\\$data));",
      "        \\$sql = \"INSERT INTO {\\$table} ({\\$columns}) VALUES ({\\$placeholders})\";",
      "",
      "        try {",
      "            \\$stmt = \\$this->conn->prepare(\\$sql);",
      "            foreach (\\$data as \\$key => \\$value) {",
      "                \\$stmt->bindValue(\":{\\$key}\", \\$value);",
      "            }",
      "            \\$stmt->execute();",
      "            return true;",
      "        } catch (PDOException \\$e) {",
      "            die(\"Insert failed: \" . \\$e->getMessage());",
      "        }",
      "    }",
      "",
      "    public function lastInsertId() ",
      "    {",
      "        return \\$this->conn->lastInsertId();",
      "    }",
      "",
      "    public function select(\\$table, \\$conditions = [], \\$columns = '*') ",
      "    {",
      "        \\$sql = \"SELECT {\\$columns} FROM {\\$table}\";",
      "        if (!empty(\\$conditions)) {",
      "            \\$conditionStrings = [];",
      "            foreach (\\$conditions as \\$key => \\$value) {",
      "                \\$conditionStrings[] = \"{\\$key} = :{\\$key}\";",
      "            }",
      "            \\$sql .= \" WHERE \" . implode(\" AND \", \\$conditionStrings);",
      "        }",
      "        try {",
      "            \\$stmt = \\$this->conn->prepare(\\$sql);",
      "            foreach (\\$conditions as \\$key => \\$value) {",
      "                \\$stmt->bindValue(\":{\\$key}\", \\$value);",
      "            }",
      "            \\$stmt->execute();",
      "            return \\$stmt->fetch(PDO::FETCH_ASSOC);",
      "        } catch (PDOException \\$e) {",
      "            die(\"Select failed: \" . \\$e->getMessage());",
      "        }",
      "    }",
      "",
      "    public function selectAll(\\$table, \\$conditions = [], \\$columns = '*', \\$orderBy = '', \\$limit = null) ",
      "    {",
      "        \\$sql = \"SELECT {\\$columns} FROM {\\$table}\";",
      "        \\$params = [];",
      "",
      "        if (!empty(\\$conditions)) {",
      "            \\$conditionStrings = [];",
      "            foreach (\\$conditions as \\$key => \\$value) {",
      "                if (is_array(\\$value) && isset(\\$value['operator'], \\$value['value'])) {",
      "                    \\$conditionStrings[] = \"{\\$key} {\\$value['operator']} :{\\$key}\";",
      "                    \\$params[\\$key] = \\$value['value'];",
      "                } else {",
      "                    \\$conditionStrings[] = \"{\\$key} = :{\\$key}\";",
      "                    \\$params[\\$key] = \\$value;",
      "                }",
      "            }",
      "            \\$sql .= \" WHERE \" . implode(\" AND \", \\$conditionStrings);",
      "        }",
      "",
      "        if (!empty(\\$orderBy)) {",
      "            \\$sql .= \" ORDER BY {\\$orderBy}\";",
      "        }",
      "        if (!empty(\\$limit)) {",
      "            \\$sql .= \" LIMIT {\\$limit}\";",
      "        }",
      "",
      "        try {",
      "            \\$stmt = \\$this->conn->prepare(\\$sql);",
      "            foreach (\\$params as \\$key => \\$value) {",
      "                \\$stmt->bindValue(\":{\\$key}\", \\$value);",
      "            }",
      "            \\$stmt->execute();",
      "            return \\$stmt->fetchAll(PDO::FETCH_ASSOC);",
      "        } catch (PDOException \\$e) {",
      "            error_log(\"Select All failed: \" . \\$e->getMessage());",
      "            return false;",
      "        }",
      "    }",
      "",
      "    public function update(\\$table, \\$data, \\$conditions) ",
      "    {",
      "        \\$setStrings = [];",
      "        foreach (\\$data as \\$key => \\$value) {",
      "            \\$setStrings[] = \"{\\$key} = :set_{\\$key}\";",
      "        }",
      "        \\$setClause = implode(\", \", \\$setStrings);",
      "",
      "        \\$conditionStrings = [];",
      "        foreach (\\$conditions as \\$key => \\$value) {",
      "            \\$conditionStrings[] = \"{\\$key} = :cond_{\\$key}\";",
      "        }",
      "        \\$conditionClause = implode(\" AND \", \\$conditionStrings);",
      "",
      "        \\$sql = \"UPDATE {\\$table} SET {\\$setClause} WHERE {\\$conditionClause}\";",
      "",
      "        try {",
      "            \\$stmt = \\$this->conn->prepare(\\$sql);",
      "            foreach (\\$data as \\$key => \\$value) {",
      "                \\$stmt->bindValue(\":set_{\\$key}\", \\$value);",
      "            }",
      "            foreach (\\$conditions as \\$key => \\$value) {",
      "                \\$stmt->bindValue(\":cond_{\\$key}\", \\$value);",
      "            }",
      "            return \\$stmt->execute();",
      "        } catch (PDOException \\$e) {",
      "            return \\$e->getMessage();",
      "        }",
      "    }",
      "",
      "    public function delete(\\$table, \\$conditions) ",
      "    {",
      "        if (empty(\\$conditions)) return false;",
      "",
      "        \\$conditionStrings = [];",
      "        foreach (\\$conditions as \\$key => \\$value) {",
      "            \\$conditionStrings[] = \"{\\$key} = :cond_{\\$key}\";",
      "        }",
      "        \\$conditionClause = implode(\" AND \", \\$conditionStrings);",
      "        \\$sql = \"DELETE FROM {\\$table} WHERE {\\$conditionClause}\";",
      "",
      "        try {",
      "            \\$stmt = \\$this->conn->prepare(\\$sql);",
      "            foreach (\\$conditions as \\$key => \\$value) {",
      "                \\$stmt->bindValue(\":cond_{\\$key}\", \\$value);",
      "            }",
      "            return \\$stmt->execute();",
      "        } catch (PDOException \\$e) {",
      "            error_log(\"Delete failed: \" . \\$e->getMessage());",
      "            return false;",
      "        }",
      "    }",
      "",
      "    public function selectWithJoin(\\$table1, \\$table2, \\$joinCondition, \\$columns = '*', \\$conditions = [], \\$orderBy = '') ",
      "    {",
      "        \\$sql = \"SELECT {\\$columns} FROM {\\$table1} INNER JOIN {\\$table2} ON {\\$joinCondition}\";",
      "        \\$params = [];",
      "",
      "        if (!empty(\\$conditions)) {",
      "            \\$conditionStrings = [];",
      "            foreach (\\$conditions as \\$key => \\$value) {",
      "                if (is_array(\\$value) && isset(\\$value['operator'], \\$value['value'])) {",
      "                    \\$conditionStrings[] = \"{\\$key} {\\$value['operator']} :{\\$key}\";",
      "                    \\$params[\\$key] = \\$value['value'];",
      "                } else {",
      "                    \\$conditionStrings[] = \"{\\$key} = :{\\$key}\";",
      "                    \\$params[\\$key] = \\$value;",
      "                }",
      "            }",
      "            \\$sql .= \" WHERE \" . implode(\" AND \", \\$conditionStrings);",
      "        }",
      "",
      "        if (!empty(\\$orderBy)) {",
      "            \\$sql .= \" ORDER BY {\\$orderBy}\";",
      "        }",
      "",
      "        try {",
      "            \\$stmt = \\$this->conn->prepare(\\$sql);",
      "            foreach (\\$params as \\$key => \\$value) {",
      "                \\$stmt->bindValue(\":{\\$key}\", \\$value);",
      "            }",
      "            \\$stmt->execute();",
      "            return \\$stmt->fetchAll(PDO::FETCH_ASSOC);",
      "        } catch (PDOException \\$e) {",
      "            error_log(\"Select with JOIN failed: \" . \\$e->getMessage());",
      "            return false;",
      "        }",
      "    }",
      "}"
    ],
    "description": "Comprehensive database wrapper with CRUD and JOIN operations"
