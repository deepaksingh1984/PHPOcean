  "Secure Crypto Class": {
    "prefix": "phpsecure_crypto",
    "body": [
      "class Secure {",
      "    private static \\$secretKey = '${1:Secret_key}';",
      "    private static \\$secretIv = '${2:www.example.com}';",
      "    private static \\$encryptMethod = \"AES-256-CBC\";",
      "",
      "    public static function Encrypt(\\$data) {",
      "        \\$key = hash('sha256', self::\\$secretKey);",
      "        \\$iv = substr(hash('sha256', self::\\$secretIv), 0, 16);",
      "        \\$result = openssl_encrypt(\\$data, self::\\$encryptMethod, \\$key, 0, \\$iv);",
      "        return base64_encode(\\$result);",
      "    }",
      "",
      "    public static function Decrypt(\\$data) {",
      "        \\$key = hash('sha256', self::\\$secretKey);",
      "        \\$iv = substr(hash('sha256', self::\\$secretIv), 0, 16);",
      "        \\$result = openssl_decrypt(base64_decode(\\$data), self::\\$encryptMethod, \\$key, 0, \\$iv);",
      "        return \\$result;",
      "    }",
      "}"
    ],
    "description": "AES-256-CBC Encryption and Decryption class"
  },
  "CSRF Token Class": {
    "prefix": "phpcsrf",
    "body": [
      "class CSRFToken {",
      "    public static function generate(\\$formName) {",
      "        if (session_status() !== PHP_SESSION_ACTIVE) {",
      "            session_start();",
      "        }",
      "        \\$token = bin2hex(random_bytes(32));",
      "        \\$_SESSION['csrf_token_' . \\$formName] = \\$token;",
      "        return \\$token;",
      "    }",
      "",
      "    public static function validate(\\$formName, \\$token) {",
      "        if (session_status() !== PHP_SESSION_ACTIVE) {",
      "            session_start();",
      "        }",
      "        \\$sessionToken = \\$_SESSION['csrf_token_' . \\$formName] ?? '';",
      "        \\$isValid = hash_equals(\\$sessionToken, \\$token);",
      "        unset(\\$_SESSION['csrf_token_' . \\$formName]);",
      "        return \\$isValid;",
      "    }",
      "}"
    ],
    "description": "Generate and validate secure CSRF tokens"
  },
  "Strict Secure Session Class": {
    "prefix": "phpsecuresession_class",
    "body": [
      "class SecureSession {",
      "    private \\$idleTimeout = 1800;",
      "    private \\$absoluteTimeout = 43200;",
      "",
      "    public function __construct() {",
      "        ini_set('session.use_strict_mode', 1);",
      "        ini_set('session.cookie_httponly', 1);",
      "        ini_set('session.use_only_cookies', 1);",
      "        ini_set('session.cookie_samesite', 'Lax');",
      "        ini_set('session.cookie_secure', 1);",
      "    }",
      "",
      "    public function start() {",
      "        if (session_status() === PHP_SESSION_NONE) {",
      "            session_start();",
      "        }",
      "",
      "        if (!isset(\\$_SESSION['created_at'])) {",
      "            \\$_SESSION['created_at'] = time();",
      "            \\$_SESSION['fingerprint'] = \\$this->generateFingerprint();",
      "        }",
      "",
      "        \\$this->verifyFingerprint();",
      "        \\$this->checkTimeouts();",
      "        \\$_SESSION['last_active'] = time();",
      "    }",
      "",
      "    private function generateFingerprint() {",
      "        \\$userAgent = isset(\\$_SERVER['HTTP_USER_AGENT']) ? \\$_SERVER['HTTP_USER_AGENT'] : 'UNKNOWN';",
      "        ",
      "        \\$ip = 'UNKNOWN';",
      "        if (isset(\\$_SERVER['HTTP_CF_CONNECTING_IP'])) {",
      "            \\$ip = \\$_SERVER['HTTP_CF_CONNECTING_IP'];",
      "        } elseif (isset(\\$_SERVER['HTTP_X_FORWARDED_FOR'])) {",
      "            \\$ipList = explode(',', \\$_SERVER['HTTP_X_FORWARDED_FOR']);",
      "            \\$ip = trim(\\$ipList[0]);",
      "        } elseif (isset(\\$_SERVER['REMOTE_ADDR'])) {",
      "            \\$ip = \\$_SERVER['REMOTE_ADDR'];",
      "        }",
      "",
      "        \\$ip = preg_replace('/\\\\.([0-9]+)$/', '.0', \\$ip);",
      "        return hash('sha256', \\$userAgent . \\$ip);",
      "    }",
      "",
      "    private function verifyFingerprint() {",
      "        if (!isset(\\$_SESSION['fingerprint']) || \\$_SESSION['fingerprint'] !== \\$this->generateFingerprint()) {",
      "            \\$this->destroy();",
      "            header(\"Location: /?error=session_timeout\");",
      "        }",
      "    }",
      "",
      "    private function checkTimeouts() {",
      "        \\$now = time();",
      "        if (isset(\\$_SESSION['last_active']) && (\\$now - \\$_SESSION['last_active'] > \\$this->idleTimeout)) {",
      "            \\$this->destroy();",
      "            header(\"Location:/?error=session_timeout\");",
      "        }",
      "        if (\\$now - \\$_SESSION['created_at'] > \\$this->absoluteTimeout) {",
      "            \\$this->destroy();",
      "            header(\"Location: /?error=session_timeout\");",
      "        }",
      "    }",
      "",
      "    public function regenerate() {",
      "        session_regenerate_id(true);",
      "        \\$_SESSION['created_at'] = time();",
      "    }",
      "",
      "    public function destroy(\\$message = \"Session terminated.\") {",
      "        session_unset();",
      "        session_destroy();",
      "        setcookie(session_name(), '', time() - 3600, '/');",
      "        die(\\$message);",
      "    }",
      "}"
    ],
    "description": "Initialize and enforce strict, highly secure session management"
  },
  "Server-Sent Events (SSE) Stream": {
    "prefix": "phpsse",
    "body": [
      "header('Content-Type: text/event-stream');",
      "header('Cache-Control: no-cache');",
      "header('Connection: keep-alive');",
      "// Prevent buffering to ensure instant delivery",
      "if (ob_get_level() > 0) {",
      "    ob_end_flush();",
      "}",
      "",
      "// Example loop for pushing data",
      "while (true) {",
      "    \\$data = [",
      "        'time' => date('c'),",
      "        'event' => '${1:status_update}',",
      "        'payload' => ${2:['user' => 'active']}",
      "    ];",
      "    ",
      "    echo \"event: {\\$data['event']}\\n\";",
      "    echo \"data: \" . json_encode(\\$data['payload']) . \"\\n\\n\";",
      "    ",
      "    flush();",
      "    ",
      "    // Break the loop if the client aborts the connection",
      "    if (connection_aborted()) {",
      "        break;",
      "    }",
      "    ",
      "    sleep(${3:2});",
      "}",
      "$0"
    ],
    "description": "Initialize a real-time Server-Sent Events (SSE) stream for browser communication"
  },
  "OpenSSL File Encryption": {
    "prefix": "phpencrypt_file",
    "body": [
      "public function encryptFile(string \\$sourcePath, string \\$destPath, string \\$key): bool",
      "{",
      "    \\$cipher = 'aes-256-cbc';",
      "    \\$ivLength = openssl_cipher_iv_length(\\$cipher);",
      "    \\$iv = random_bytes(\\$ivLength);",
      "    ",
      "    \\$data = file_get_contents(\\$sourcePath);",
      "    if (\\$data === false) {",
      "        throw new \\RuntimeException('Could not read source file for encryption.');",
      "    }",
      "    ",
      "    \\$encrypted = openssl_encrypt(\\$data, \\$cipher, \\$key, OPENSSL_RAW_DATA, \\$iv);",
      "    if (\\$encrypted === false) {",
      "        throw new \\RuntimeException('Encryption failed.');",
      "    }",
      "    ",
      "    // Prepend the IV to the encrypted data for decryption later",
      "    \\$payload = \\$iv . \\$encrypted;",
      "    ",
      "    return file_put_contents(\\$destPath, \\$payload) !== false;",
      "    $0",
      "}"
    ],
    "description": "Securely encrypt a file (like generated XML) using OpenSSL before storage or transmission"
  },
  "API CORS and Preflight Router": {
    "prefix": "phpcors",
    "body": [
      "// Define allowed origins in production",
      "\\$allowedOrigin = '${1:https://yourfrontend.com}';",
      "",
      "if (isset(\\$_SERVER['HTTP_ORIGIN']) && \\$_SERVER['HTTP_ORIGIN'] === \\$allowedOrigin) {",
      "    header(\"Access-Control-Allow-Origin: {\\$allowedOrigin}\");",
      "    header('Access-Control-Allow-Credentials: true');",
      "    header('Access-Control-Max-Age: 86400');    // cache for 1 day",
      "}",
      "",
      "// Access-Control headers are received during OPTIONS requests",
      "if (\\$_SERVER['REQUEST_METHOD'] == 'OPTIONS') {",
      "    if (isset(\\$_SERVER['HTTP_ACCESS_CONTROL_REQUEST_METHOD'])) {",
      "        header(\"Access-Control-Allow-Methods: GET, POST, OPTIONS, PUT, DELETE\");",
      "    }",
      "    if (isset(\\$_SERVER['HTTP_ACCESS_CONTROL_REQUEST_HEADERS'])) {",
      "        header(\"Access-Control-Allow-Headers: {\\$_SERVER['HTTP_ACCESS_CONTROL_REQUEST_HEADERS']}\");",
      "    }",
      "    exit(0);",
      "}",
      "$0"
    ],
    "description": "Handle strict CORS headers and OPTIONS preflight requests for decoupled APIs"
  },
  "Secure Background Script Execution": {
    "prefix": "phpshell",
    "body": [
      "public function executeBackgroundProcess(string \\$scriptPath, array \\$args): string",
      "{",
      "    // Base command (e.g., python3 or a compiled binary)",
      "    \\$command = escapeshellcmd('${1:python3} ' . \\$scriptPath);",
      "    ",
      "    // Append and safely escape all arguments (e.g., passing image/video paths)",
      "    foreach (\\$args as \\$arg) {",
      "        \\$command .= ' ' . escapeshellarg(\\$arg);",
      "    }",
      "    ",
      "    // Capture standard output and standard error",
      "    \\$command .= ' 2>&1';",
      "    ",
      "    exec(\\$command, \\$output, \\$returnCode);",
      "    ",
      "    if (\\$returnCode !== 0) {",
      "        error_log(\"Process failed with code {\\$returnCode}: \" . implode(\"\\n\", \\$output));",
      "        throw new \\RuntimeException('Background process execution failed.');",
      "    }",
      "    ",
      "    return implode(\"\\n\", \\$output);",
      "    $0",
      "}"
    ],
    "description": "Safely execute a background script (like Python or FFMPEG) with escaped arguments"
  },
  "AJAX POST Request (Fetch)": {
