  "Master-Slave Database Split": {
    "prefix": "phpmaster_slave",
    "body": [
      "",
      "namespace ${1:App\\\\Database};",
      "",
      "class ${2:DBManager} ",
      "{",
      "    private \\PDO \\$master;",
      "    private \\PDO \\$slave;",
      "",
      "    public function __construct() ",
      "    {",
      "        \\$options = [",
      "            \\PDO::ATTR_ERRMODE            => \\PDO::ERRMODE_EXCEPTION,",
      "            \\PDO::ATTR_DEFAULT_FETCH_MODE => \\PDO::FETCH_ASSOC,",
      "            \\PDO::ATTR_EMULATE_PREPARES   => false,",
      "        ];",
      "",
      "        \\$this->master = new \\PDO(\"mysql:host=${3:master_host};dbname=${4:dbname};charset=utf8mb4\", '${5:user}', '${6:pass}', \\$options);",
      "        \\$this->slave = new \\PDO(\"mysql:host=${7:slave_host};dbname=${4:dbname};charset=utf8mb4\", '${5:user}', '${6:pass}', \\$options);",
      "    }",
      "",
      "    public function getWriteConnection(): \\PDO ",
      "    {",
      "        return \\$this->master;",
      "    }",
      "",
      "    public function getReadConnection(): \\PDO ",
      "    {",
      "        return \\$this->slave;",
      "    }",
      "    $0",
      "}"
    ],
    "description": "Initialize a Master-Slave PDO connection architecture"
  },
  "High-Concurrency Batch Insert": {
    "prefix": "phpbatchinsert",
    "body": [
      "public function batchInsert(array \\$data): int ",
      "{",
      "    if (empty(\\$data)) return 0;",
      "    ",
      "    \\$columns = array_keys(\\$data[0]);",
      "    \\$columnList = implode(', ', \\$columns);",
      "    ",
      "    \\$rowPlaces = '(' . implode(', ', array_fill(0, count(\\$columns), '?')) . ')';",
      "    \\$allPlaces = implode(', ', array_fill(0, count(\\$data), \\$rowPlaces));",
      "    ",
      "    \\$sql = \"INSERT INTO ${1:table_name} (\\$columnList) VALUES \\$allPlaces\";",
      "    ",
      "    \\$stmt = \\$this->${2:master}->prepare(\\$sql);",
      "    ",
      "    \\$flatValues = [];",
      "    foreach (\\$data as \\$row) {",
      "        foreach (\\$columns as \\$col) {",
      "            \\$flatValues[] = \\$row[\\$col];",
      "        }",
      "    }",
      "    ",
      "    \\$stmt->execute(\\$flatValues);",
      "    return \\$stmt->rowCount();",
      "    $0",
      "}"
    ],
    "description": "Perform an optimized batch insert for multiple rows"
  },
  "Database Transaction Block": {
    "prefix": "phptransaction",
    "body": [
      "try {",
      "    \\$this->${1:master}->beginTransaction();",
      "",
      "    \\$stmt1 = \\$this->${1:master}->prepare(\"${2:UPDATE table1 SET col = ? WHERE id = ?}\");",
      "    \\$stmt1->execute([${3:\\$val1}, ${4:\\$id1}]);",
      "",
      "    \\$stmt2 = \\$this->${1:master}->prepare(\"${5:UPDATE table2 SET col = ? WHERE id = ?}\");",
      "    \\$stmt2->execute([${6:\\$val2}, ${7:\\$id2}]);",
      "",
      "    \\$this->${1:master}->commit();",
      "} catch (\\Exception \\$e) {",
      "    if (\\$this->${1:master}->inTransaction()) {",
      "        \\$this->${1:master}->rollBack();",
      "    }",
      "    throw \\$e;",
      "    $0",
      "}"
    ],
    "description": "Safely execute multiple queries within a PDO transaction"
  },
