  "cURL Request with SSL Encryption": {
    "prefix": "phpcurl",
    "body": [
      "public function sendSecureRequest(string \\$url, array \\$payload): array",
      "{",
      "    \\$ch = curl_init(\\$url);",
      "    ",
      "    \\$jsonData = json_encode(\\$payload);",
      "    ",
      "    curl_setopt_array(\\$ch, [",
      "        CURLOPT_RETURNTRANSFER => true,",
      "        CURLOPT_POST           => true,",
      "        CURLOPT_POSTFIELDS     => \\$jsonData,",
      "        CURLOPT_HTTPHEADER     => [",
      "            'Content-Type: application/json',",
      "            'Content-Length: ' . strlen(\\$jsonData),",
      "            'Authorization: Bearer ' . \\$this->${1:apiToken}",
      "        ],",
      "        CURLOPT_SSL_VERIFYPEER => true,",
      "        CURLOPT_SSL_VERIFYHOST => 2,",
      "        CURLOPT_TIMEOUT        => ${2:30}",
      "    ]);",
      "    ",
      "    \\$response = curl_exec(\\$ch);",
      "    \\$error    = curl_error(\\$ch);",
      "    \\$httpCode = curl_getinfo(\\$ch, CURLINFO_HTTP_CODE);",
      "    ",
      "    curl_close(\\$ch);",
      "    ",
      "    if (\\$error) {",
      "        throw new \\RuntimeException('cURL Error: ' . \\$error);",
      "    }",
      "    ",
      "    return [",
      "        'status' => \\$httpCode,",
      "        'data'   => json_decode(\\$response, true)",
      "    ];",
      "    $0",
      "}"
    ],
    "description": "Execute a secure POST request via cURL with strict SSL verification"
  },
