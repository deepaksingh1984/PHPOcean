  "Secure File Upload Handler": {
    "prefix": "phpupload",
    "body": [
      "public function handleUpload(array \\$fileInfo, string \\$destinationDir): string",
      "{",
      "    \\$allowedMimeTypes = ['${1:image/jpeg}', '${2:image/png}', '${3:application/pdf}'];",
      "    \\$maxFileSize = ${4:5242880}; // 5MB",
      "    ",
      "    if (\\$fileInfo['error'] !== UPLOAD_ERR_OK) {",
      "        throw new \\RuntimeException('Upload error code: ' . \\$fileInfo['error']);",
      "    }",
      "    ",
      "    if (\\$fileInfo['size'] > \\$maxFileSize) {",
      "        throw new \\RuntimeException('File exceeds maximum allowed size.');",
      "    }",
      "    ",
      "    \\$finfo = new \\finfo(FILEINFO_MIME_TYPE);",
      "    \\$mimeType = \\$finfo->file(\\$fileInfo['tmp_name']);",
      "    ",
      "    if (!in_array(\\$mimeType, \\$allowedMimeTypes, true)) {",
      "        throw new \\RuntimeException('Invalid file type.');",
      "    }",
      "    ",
      "    \\$extension = pathinfo(\\$fileInfo['name'], PATHINFO_EXTENSION);",
      "    \\$safeFileName = bin2hex(random_bytes(16)) . '.' . \\$extension;",
      "    \\$targetPath = rtrim(\\$destinationDir, '/') . '/' . \\$safeFileName;",
      "    ",
      "    if (!move_uploaded_file(\\$fileInfo['tmp_name'], \\$targetPath)) {",
      "        throw new \\RuntimeException('Failed to move uploaded file.');",
      "    }",
      "    ",
      "    return \\$targetPath;",
      "    $0",
      "}"
    ],
    "description": "Securely process and validate an uploaded file"
  },
