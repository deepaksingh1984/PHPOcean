  "PHP Database Singleton": {
    "prefix": "phpdatabase",
    "body": [
      "",
      "namespace ${1:App\\Database};",
      "",
      "/**",
      " * PHPOcean Secure Database Singleton",
      " * High-performance PDO wrapper with Master/Slave readiness.",
      " */",
      "class Database ",
      "{",
      "\tprivate \\PDO \\$pdo;",
      "\tprivate static \\$instance = null;",
      "",
      "\tprivate function __construct() ",
      "\t{",
      "\t\t\\$dsn = \"mysql:host=${2:localhost};dbname=${3:database};charset=utf8mb4\";",
      "\t\t\\$options = [",
      "\t\t\t\\PDO::ATTR_ERRMODE            => \\PDO::ERRMODE_EXCEPTION,",
      "\t\t\t\\PDO::ATTR_DEFAULT_FETCH_MODE => \\PDO::FETCH_ASSOC,",
      "\t\t\t\\PDO::ATTR_EMULATE_PREPARES   => false,",
      "\t\t];",
      "\t\t",
      "\t\ttry {",
      "\t\t\t\\$this->pdo = new \\PDO(\\$dsn, '${4:username}', '${5:password}', \\$options);",
      "\t\t} catch (\\PDOException \\$e) {",
      "\t\t\tthrow new \\PDOException(\\$e->getMessage(), (int)\\$e->getCode());",
      "\t\t}",
      "\t}",
      "",
      "\tpublic static function getInstance(): self ",
      "\t{",
      "\t\tif (self::\\$instance === null) {",
      "\t\t\tself::\\$instance = new self();",
      "\t\t}",
      "\t\treturn self::\\$instance;",
      "\t}",
      "",
      "\tpublic function getConnection(): \\PDO ",
      "\t{",
      "\t\treturn \\$this->pdo;",
      "\t}",
      "",
      "\tpublic function query(string \\$sql, array \\$params = []) ",
      "\t{",
      "\t\t\\$stmt = \\$this->pdo->prepare(\\$sql);",
      "\t\t\\$stmt->execute(\\$params);",
      "\t\treturn \\$stmt;",
      "\t}",
      "}"
    ],
    "description": "Create a secure, singleton PDO database class with PHPOcean best practices."
  },
